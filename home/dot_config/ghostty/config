theme = Duotone Dark
cursor-style = block
mouse-hide-while-typing = true
window-height = 30
window-width = 130

macos-option-as-alt = right
keybind = alt+left=unbind
keybind = alt+right=unbind

theme = enhanced-dark

shell-integration = fish

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

term = xterm-256color
font-family            = "MonoLisa Regular Nerd Font Complete Mono"
font-family-bold       = "MonoLisa Bold Nerd Font Complete Mono"
font-family-italic     = "MonoLisa Regular Italic Nerd Font Complete Mono"
font-family-bold-italic= "MonoLisa Bold Italic Nerd Font Complete Mono"
font-size              = 18
scrollback-limit       = 1048576
window-width           = 150
window-height          = 35
window-position-x      = 250
window-position-y      = 250
macos-titlebar-style   = tabs
window-padding-x       = 0
window-padding-y       = 0
window-padding-balance = true
background-opacity     = 1

