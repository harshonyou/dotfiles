#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen {
        zmk,physical-layout = &foostan_corne_6col_layout;

        //zmk,matrix_transform = &default_transform;
        //zmk,matrix_transform = &five_column_transform;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            label = "AEI";

            bindings = <
&kp MINUS      &kp Q  &kp W  &kp F      &kp P  &kp B        &kp J                  &kp L  &kp U         &kp Y    &kp SEMI  &kp SQT
&kp TAB        &kp A  &kp R  &kp S      &kp T  &kp G        &kp M                  &kp N  &kp E         &kp I    &kp O     &kp BSPC
&kp LS(EQUAL)  &kp Z  &kp X  &kp C      &kp D  &kp V        &kp K                  &kp H  &kp COMMA     &kp DOT  &kp FSLH  &kp ESC
                             &kp LCTRL  &mo 1  &kp SPACE    &mt LEFT_SHIFT RETURN  &mo 2  &kp LEFT_ALT
            >;
        };

        nums-symbs {
            bindings = <
&kp GRAVE  &kp N6           &kp N3    &kp N1                &kp N2                 &kp N7         &kp N9         &kp N4     &kp N0     &kp N5          &kp N8         &kp PRINTSCREEN
&kp TILDE  &kp DOLLAR       &kp PLUS  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AT_SIGN    &kp PIPE       &kp MINUS  &kp EQUAL  &kp UNDERSCORE  &kp STAR       &kp BSPC
&kp CARET  &kp EXCLAMATION  &kp HASH  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DELETE     &kp AMPERSAND  &kp LBKT   &kp RBKT   &kp PERCENT     &kp BACKSLASH  &kp K_LOCK
                                      &trans                &trans                 &trans         &kp LS(ENTER)  &trans     &trans
            >;
        };

        controls {
            bindings = <
&trans  &trans  &trans      &trans        &trans            &trans        &trans    &trans    &trans  &trans     &trans    &trans
&trans  &trans  &kp C_PREV  &kp C_MUTE    &kp C_PLAY_PAUSE  &kp C_NEXT    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp LEFT  &trans
&trans  &trans  &trans      &kp C_VOL_DN  &kp C_VOL_UP      &trans        &trans    &trans    &trans  &trans     &trans    &trans
                            &trans        &mo 3             &trans        &trans    &trans    &trans
            >;
        };

        bluetooth {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_CLR  &bt BT_PRV  &bt BT_NXT  &studio_unlock  &trans  &bt BT_CLR_ALL
&trans  &trans        &trans        &trans        &trans        &trans          &trans      &trans      &trans      &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans          &trans      &trans      &trans      &trans  &trans  &trans
                                    &trans        &trans        &trans          &trans      &trans      &trans
            >;
        };
    };
};
