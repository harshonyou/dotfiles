#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen {
        zmk,matrix_transform = &default_transform;

        //zmk,matrix_transform = &five_column_transform;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            label = "CMAXDH";

            bindings = <
&kp MINUS  &kp Q  &kp W  &kp F           &kp P  &kp B        &kp J                &kp L  &kp U       &kp Y    &kp SEMI  &kp SQT
&kp TAB    &kp A  &kp R  &kp S           &kp T  &kp G        &kp M                &kp N  &kp E       &kp I    &kp O     &kp BSPC
&kp EQUAL  &kp Z  &kp X  &kp C           &kp D  &kp V        &kp K                &kp H  &kp COMMA   &kp DOT  &kp FSLH  &kp ESC
                         &mt LCTRL LGUI  &mo 1  &kp SPACE    &mt RET RIGHT_SHIFT  &mo 2  &mt RALT X
            >;
        };

        nums-symbs {
            bindings = <
&trans  &kp N6        &kp N3         &kp N1        &kp N2        &kp N7           &kp N9        &kp N4     &kp N0     &kp N5         &kp N8         &trans
&trans  &kp LS(DLLR)  &kp LS(PLUS)   &kp LS(LPAR)  &kp LS(RPAR)  &kp LS(AT)       &kp LS(PIPE)  &kp MINUS  &kp EQUAL  &kp LS(UNDER)  &kp STAR       &kp BSPC
&trans  &kp LS(EXCL)  &kp LS(POUND)  &kp LS(LBRC)  &kp LS(RBRC)  &kp LS(TILDE)    &kp LS(AMPS)  &kp LBKT   &kp RBKT   &kp LS(PRCNT)  &kp LS(CARET)  &trans
                                     &trans        &trans        &trans           &trans        &trans     &trans
            >;
        };

        controls {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3      &bt BT_SEL 4    &trans    &trans    &trans  &trans     &trans  &trans
&trans      &trans        &kp C_PREV    &kp C_MUTE    &kp C_PLAY_PAUSE  &kp C_NEXT      &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans      &trans        &trans        &kp C_VOL_DN  &kp C_VOL_UP      &trans          &trans    &trans    &trans  &trans     &trans  &trans
                                        &trans        &trans            &trans          &trans    &trans    &trans
            >;
        };
    };
};
